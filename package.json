{
  "name": "@hund.studio/mdgen",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "keywords": [
    "markdown",
    "cli",
    "documentation-generator",
    "markdown-generator"
  ],
  "files": [
    "dist-cli",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hund-studio/mdgen.git"
  },
  "homepage": "https://mdgen.hund.studio/",
  "scripts": {
    "build:cli": "tsc -b && vite build  --config vite.config.cli.ts",
    "build:example": "npm run build:cli && node ./dist-cli/cli.js -s ./examples/dnd-adventure -o ./dist-md -n dnd-adventure -w",
    "build:static": "tsc -b && vite build --config vite.config.static.ts",
    "build:tool": "tsc -b && vite build  --config vite.config.tool.ts",
    "build": "npm run build:static && npm run build:tool",
    "copy:readme": "cp docs/readme.md ./README.md",
    "dev:cli": "vite build --config vite.config.cli.ts --watch",
    "dev": "vite --config vite.config.tool.ts",
    "lint": "eslint .",
    "postpublish": "rm ./README.md",
    "prepublishOnly": "npm run build:cli && npm run copy:readme",
    "preview": "vite preview",
    "release:beta": "npm version prerelease --preid beta && git push --follow-tags",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags"
  },
  "bin": {
    "mdgen": "dist-cli/cli.js"
  },
  "dependencies": {
    "@orama/highlight": "^0.1.9",
    "@orama/orama": "^3.1.17",
    "chokidar": "^5.0.0",
    "commander": "^14.0.2",
    "file-saver": "^2.0.5",
    "handlebars": "^4.7.8",
    "jszip": "^3.10.1",
    "motion": "^12.23.26",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "slugify": "^1.6.6",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "sass-embedded": "^1.93.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
