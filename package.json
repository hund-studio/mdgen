{
  "name": "@hund.studio/mdgen",
  "private": false,
  "version": "0.0.1-beta.3",
  "type": "module",
  "keywords": [
    "markdown",
    "cli",
    "documentation-generator",
    "markdown-generator"
  ],
  "files": [
    "dist-cli",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hund-studio/mdgen.git"
  },
  "homepage": "https://mdgen.hund.studio/",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "copy:readme": "cp docs/readme.md ./README.md",
    "dev": "vite --config vite.config.tool.ts",
    "docs": "node dist-cli/cli.js -s examples/docs -o public -n docs -u /docs/",
    "dev:preview": "mkdir -p ./dist-md && echo '➜ Preview doc: http://localhost:8080/docs/' && exec live-server ./dist-md --port=8080 --no-browser --quiet",
    "dev:static": "tsx scripts/dev.ts",
    "lint": "eslint .",
    "postpublish": "rm ./README.md",
    "prepublishOnly": "npm run build && npm run copy:readme",
    "preview": "vite preview --base /docs/ --outDir ./dist-md/docs",
    "release:beta": "npm version prerelease --preid beta && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:patch": "npm version patch && git push --follow-tags"
  },
  "bin": {
    "mdgen": "dist-cli/cli.js"
  },
  "dependencies": {
    "@orama/highlight": "^0.1.9",
    "@orama/orama": "^3.1.17",
    "chokidar": "^5.0.0",
    "commander": "^14.0.2",
    "esbuild": "^0.28.1",
    "file-saver": "^2.0.5",
    "handlebars": "^4.7.8",
    "jszip": "^3.10.1",
    "motion": "^12.23.26",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.12.0",
    "remark-gfm": "^4.0.1",
    "slugify": "^1.6.6",
    "tree-kill": "^1.2.2",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "chalk": "^5.6.2",
    "chokidar-cli": "^3.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "live-server": "^1.2.2",
    "sass-embedded": "^1.93.3",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
